  25          void KeyCheck(void)
  26          {
  27   1          static unsigned char Key_Status_Check = 0; // 定义按键状态判断，0为默认状态，1为去抖
             -检测，2表示按键松开
  28   1          switch (Key_Status_Check)
  29   1          {
  30   2          case 0:                       // 默认状态
  31   2              if (P32 == 0)             // 检测按键电位为0
  32   2                  Key_Status_Check = 1; // 视按键为按下，进入去抖检测
  33   2              break;
  34   2      
  35   2          case 1:           // 判断按键是否真的按下
  36   2              if (P32 == 0) // 检测按键电位为低，若这一步仍为0，则判定这次按下通过
  37   2              {
  38   3                  KeyReset_State = 1;   // 按键按下状态标记
  39   3                  Key_Status_Check = 2; // 进入下一个状态：等待按键松开
  40   3              }
  41   2              else                      // 按键电位变高，说明仍有干扰，返回默认状态
  42   2                  Key_Status_Check = 0; // 检测状态重置为默认
  43   2              break;
  44   2      
  45   2          case 2:                       // 等待按键松开
  46   2              if (P32 == 1)             // 按键电位为高，视为松开
  47   2                  Key_Status_Check = 0; // 检测状态重置为默认
  48   2              break;
  49   2          default:
  50   2              Key_Status_Check = 0; // 其它情况均重置为默认
  51   2              break;
  52   2          }
  53   1      }
