 105          void LED_Show(void)
 106          {
 107   1          unsigned char tableHead[] = {
 108   1              // 数据包头 | 卡地址| 字节长度
 109   1              0x55, 0xAA, 0x01, 0x00};
 110   1          unsigned char tableDisplaySettting[] = {
 111   1              0xC0, // 指令码 - C0 = 发送内容到显示屏
 112   1              0x00, // 编号 - 存储在0号位置
 113   1              0x04, // 类型 - 显示数值
 114   1              0x00, // 显示模式 - 立即显示
 115   1              0x00, // 字移动速度 - 不移动
C51 COMPILER V9.60.7.0   MAIN                                                              06/12/2025 15:56:42 PAGE 3   

 116   1              0x00, // 字停留秒数 - 不停留
 117   1              0x03, // 颜色 - 01红 02绿 03黄 // 但屏幕是单色，所以本项实际上无效
 118   1          };
 119   1          unsigned char tableTimeData[16];
 120   1          unsigned char tableEnd = 0x00;
 121   1          unsigned char length = 0, i = 0, sum = 0;
 122   1      
 123   1          sprintf((char *)tableTimeData, "%02d:%02d.%02d", minutes, seconds, (int)milliseconds / 10);
 124   1          length = strlen((char *)tableTimeData); // 计算tableTimeData的实际长度
 125   1          // 计算tableDisplaySettting和tableTimeData的累加和
 126   1          for (i = 0; i < sizeof(tableDisplaySettting); i++)
 127   1              sum += tableDisplaySettting[i];
 128   1          for (i = 0; i < length; i++)
 129   1              sum += tableTimeData[i];
 130   1          // 提取最低的8位，作为校验码
 131   1          tableEnd = (unsigned char)(sum & 0xFF);
 132   1      
 133   1          // 字节长度 = tableDisplaySettting + tableTimeData + tableEnd 的长度
 134   1          tableHead[3] = sizeof(tableDisplaySettting) + length + 1;
 135   1          // 发送数据
 136   1          for (i = 0; i < sizeof(tableHead); i++)
 137   1              SendData(tableHead[i]);
 138   1          for (i = 0; i < sizeof(tableDisplaySettting); i++)
 139   1              SendData(tableDisplaySettting[i]);
 140   1          for (i = 0; i < length; i++)
 141   1              SendData(tableTimeData[i]);
 142   1          SendData(tableEnd); // 发送校验码
 143   1      }
