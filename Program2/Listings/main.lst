  98          void LED_Show(void)
  99          {
 100   1          unsigned char tableHead[] = {
 101   1              // 数据包头 | 卡地址| 字节长度
 102   1              0x55, 0xAA, 0x01, 0x00};
 103   1          unsigned char tableDisplaySettting[] = {
 104   1              0xC0, // 指令码 - C0 = 发送内容到显示屏
 105   1              0x00, // 编号 - 存储在0号位置
 106   1              0x04, // 类型 - 显示数值
 107   1              0x00, // 显示模式 - 立即显示
 108   1              0x00, // 字移动速度 - 不移动
 109   1              0x00, // 字停留秒数 - 不停留
 110   1              0x03, // 颜色 - 01红 02绿 03黄 // 但屏幕是单色，所以本项实际上无效
 111   1          };
 112   1          unsigned char tableTimeData[16];
 113   1          unsigned char tableEnd = 0x00;
 114   1          unsigned char length = 0, i = 0, sum = 0;
 115   1      
 116   1          sprintf((char *)tableTimeData, "%02d:%02d.%02d", minutes, seconds, (int)milliseconds / 10);
C51 COMPILER V9.60.7.0   MAIN                                                              05/04/2025 20:23:22 PAGE 3   

 117   1          length = strlen((char *)tableTimeData); // 计算tableTimeData的实际长度
 118   1          // 计算tableDisplaySettting和tableTimeData的累加和
 119   1          for (i = 0; i < sizeof(tableDisplaySettting); i++)
 120   1              sum += tableDisplaySettting[i];
 121   1          for (i = 0; i < length; i++)
 122   1              sum += tableTimeData[i];
 123   1          // 提取最低的8位，作为校验码
 124   1          tableEnd = (unsigned char)(sum & 0xFF);
 125   1      
 126   1          // 字节长度 = tableDisplaySettting + tableTimeData + tableEnd 的长度
 127   1          tableHead[3] = sizeof(tableDisplaySettting) + length + 1;
 128   1          // 发送数据
 129   1          for (i = 0; i < sizeof(tableHead); i++)
 130   1              SendData(tableHead[i]);
 131   1          for (i = 0; i < sizeof(tableDisplaySettting); i++)
 132   1              SendData(tableDisplaySettting[i]);
 133   1          for (i = 0; i < length; i++)
 134   1              SendData(tableTimeData[i]);
 135   1          SendData(tableEnd); // 发送校验码
 136   1      }
