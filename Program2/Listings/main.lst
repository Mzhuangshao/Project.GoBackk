  32   1          static unsigned char Key_Status_Check = 0; // 定义按键状态判断，0为默认状态，1为去抖
             -检测，2表示按键松开
  33   1          switch (Key_Status_Check)
  34   1          {
  35   2          case 0:                       // 默认状态
  36   2              if (KeyReset == 0)             // 检测按键电位为0
  37   2                  Key_Status_Check = 1; // 视按键为按下，进入去抖检测
  38   2              break;
  39   2      
  40   2          case 1:           // 判断按键是否真的按下
  41   2              if (KeyReset == 0) // 检测按键电位为低，若这一步仍为0，则判定这次按下通过
  42   2              {
  43   3                  KeyReset_State = 1;   // 按键按下状态标记
  44   3                  Key_Status_Check = 2; // 进入下一个状态：等待按键松开
  45   3              }
  46   2              else                      // 按键电位变高，说明仍有干扰，返回默认状态
  47   2                  Key_Status_Check = 0; // 检测状态重置为默认
  48   2              break;
  49   2      
  50   2          case 2:                       // 等待按键松开
  51   2              if (KeyReset == 1)             // 按键电位为高，视为松开
  52   2                  Key_Status_Check = 0; // 检测状态重置为默认
  53   2              break;
