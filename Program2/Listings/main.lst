 118          void LED_Show(void)
 119          {
 120   1          unsigned char tableHead[] = {
 121   1              // 数据包头 | 卡地址| 字节长度
 122   1              0x55, 0xAA, 0x01, 0x00};
 123   1          unsigned char tableDisplaySettting[] = {
 124   1              0xC0, // 指令码 - C0 = 发送内容到显示屏
 125   1              0x00, // 编号 - 存储在0号位置
 126   1              0x04, // 类型 - 显示数值
 127   1              0x00, // 显示模式 - 立即显示
 128   1              0x00, // 字移动速度 - 不移动
 129   1              0x00, // 字停留秒数 - 不停留
 130   1              0x03, // 颜色 - 01红 02绿 03黄 // 但屏幕是单色，所以本项实际上无效
 131   1          };
 132   1          unsigned char tableTimeData[16];
 133   1          unsigned char tableEnd = 0x00;
 134   1          unsigned char length = 0, i = 0, sum = 0;
 135   1      
 136   1          sprintf((char *)tableTimeData, "%02d:%02d.%02d", minutes, seconds, (int)milliseconds / 10);
 137   1          length = strlen((char *)tableTimeData); // 计算tableTimeData的实际长度
 138   1          // 计算tableDisplaySettting和tableTimeData的累加和
 139   1          for (i = 0; i < sizeof(tableDisplaySettting); i++)
 140   1              sum += tableDisplaySettting[i];
 141   1          for (i = 0; i < length; i++)
 142   1              sum += tableTimeData[i];
 143   1          // 提取最低的8位，作为校验码
 144   1          tableEnd = (unsigned char)(sum & 0xFF);
 145   1      
 146   1          // 字节长度 = tableDisplaySettting + tableTimeData + tableEnd 的长度
 147   1          tableHead[3] = sizeof(tableDisplaySettting) + length + 1;
 148   1          // 发送数据
 149   1          for (i = 0; i < sizeof(tableHead); i++)
 150   1              SendData(tableHead[i]);
 151   1          for (i = 0; i < sizeof(tableDisplaySettting); i++)
 152   1              SendData(tableDisplaySettting[i]);
 153   1          for (i = 0; i < length; i++)
 154   1              SendData(tableTimeData[i]);
 155   1          SendData(tableEnd); // 发送校验码
 156   1      }
