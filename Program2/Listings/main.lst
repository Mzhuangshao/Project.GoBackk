  14          void Timer0_Init(void) // 1毫秒@11.0592MHz
  15          {
  16   1          AUXR |= 0x80; // 定时器时钟1T模式
  17   1          TMOD &= 0xF0; // 设置定时器模式
  18   1          TL0 = 0xCD;   // 设置定时初始值
  19   1          TH0 = 0xD4;   // 设置定时初始值
  20   1          TF0 = 0;      // 清除TF0标志
