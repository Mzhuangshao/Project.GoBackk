 207          void LED_Show(void)
 208          {
 209   1          unsigned char tableHead[] = {
 210   1              // 数据包头 | 卡地址| 字节长度
 211   1              0x55, 0xAA, 0x01, 0x00};
 212   1          unsigned char tableDisplaySettting[] = {
 213   1              0xC0, // 指令码 - C0 = 发送内容到显示屏
 214   1              0x00, // 编号 - 存储在0号位置
 215   1              0x04, // 类型 - 显示数值
 216   1              0x00, // 显示模式 - 立即显示
 217   1              0x00, // 字移动速度 - 不移动
 218   1              0x00, // 字停留秒数 - 不停留
 219   1              0x03, // 颜色 - 01红 02绿 03黄 // 但屏幕是单色，所以本项实际上无效
 220   1          };
 221   1          unsigned char tableTimeData[16];
 222   1          unsigned char tableEnd = 0x00;
 223   1          unsigned char length = 0, i = 0, sum = 0;
 224   1      
 225   1          sprintf((char *)tableTimeData, "%02d:%02d.%02d", minutes, seconds, (int)milliseconds / 10);
 226   1          length = strlen((char *)tableTimeData); // 计算tableTimeData的实际长度
 227   1          // 计算tableDisplaySettting和tableTimeData的累加和
 228   1          for (i = 0; i < sizeof(tableDisplaySettting); i++)
 229   1              sum += tableDisplaySettting[i];
 230   1          for (i = 0; i < length; i++)
 231   1              sum += tableTimeData[i];
 232   1          // 提取最低的8位，作为校验码
 233   1          tableEnd = (unsigned char)(sum & 0xFF);
 234   1      
 235   1          // 字节长度 = tableDisplaySettting + tableTimeData + tableEnd 的长度
 236   1          tableHead[3] = sizeof(tableDisplaySettting) + length + 1;
C51 COMPILER V9.60.7.0   MAIN                                                              05/05/2025 21:17:30 PAGE 5   

 237   1          // 发送数据
 238   1          for (i = 0; i < sizeof(tableHead); i++)
 239   1              SendData(tableHead[i]);
 240   1          for (i = 0; i < sizeof(tableDisplaySettting); i++)
 241   1              SendData(tableDisplaySettting[i]);
 242   1          for (i = 0; i < length; i++)
 243   1              SendData(tableTimeData[i]);
 244   1          SendData(tableEnd); // 发送校验码
 245   1      }
