  19          void SendData(unsigned char dat)
  20          {
  21   1          while (UartBusy)
  22   1              ; // 等待前面的数据发送完成
  23   1          UartBusy = 1;
  24   1          SBUF = dat; // 写数据到UART数据寄存器
  25   1      }
  26          
  27          void Uart1_Isr(void) interrupt 4
  28          {
  29   1          if (TI)       // 检测串口1发送中断
  30   1              TI = 0;   // 清除串口1发送中断请求位
