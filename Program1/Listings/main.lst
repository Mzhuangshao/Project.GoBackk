  69          void LED_Show(void)
  70          {
  71   1          unsigned char tableHead[] = {
  72   1              // 数据包头 | 卡地址| 字节长度
  73   1              0x55, 0xAA, 0x01, 0x00};
  74   1          unsigned char tableDisplaySettting[] = {
  75   1              0xC0, // 指令码 - C0 = 发送内容到显示屏
  76   1              0x00, // 编号 - 存储在0号位置
  77   1              0x04, // 类型 - 显示数值
  78   1              0x00, // 显示模式 - 立即显示
  79   1              0x00, // 字移动速度 - 不移动
  80   1              0x00, // 字停留秒数 - 不停留
  81   1              0x03, // 颜色 - 01红 02绿 03黄 // 但屏幕是单色，所以本项实际上无效
  82   1          };
  83   1          unsigned char tableTimeData[16];
  84   1          unsigned char tableEnd = 0x00;
  85   1          unsigned char length = 0, i = 0, sum = 0;
  86   1      
  87   1          sprintf((char *)tableTimeData, "%02d:%02d.%02d", minute, second, (int)millisecond / 10);
  88   1          length = strlen((char *)tableTimeData); // 计算tableTimeData的实际长度
  89   1          // 计算tableDisplaySettting和tableTimeData的累加和
  90   1          for (i = 0; i < sizeof(tableDisplaySettting); i++)
  91   1              sum += tableDisplaySettting[i];
  92   1          for (i = 0; i < length; i++)
  93   1              sum += tableTimeData[i];
  94   1          // 提取最低的8位，作为校验码
  95   1          tableEnd = (unsigned char)(sum & 0xFF);
  96   1      
  97   1          // 字节长度 = tableDisplaySettting + tableTimeData + tableEnd 的长度
  98   1          tableHead[3] = sizeof(tableDisplaySettting) + length + 1;
  99   1          // 发送数据
 100   1          for (i = 0; i < sizeof(tableHead); i++)
 101   1              SendData(tableHead[i]);
 102   1          for (i = 0; i < sizeof(tableDisplaySettting); i++)
 103   1              SendData(tableDisplaySettting[i]);
 104   1          for (i = 0; i < length; i++)
 105   1              SendData(tableTimeData[i]);
 106   1          SendData(tableEnd); // 发送校验码
 107   1      }
